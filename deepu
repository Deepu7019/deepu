class GestureDemoScreen extends StatefulWidget {
  const GestureDemoScreen({super.key});

  @override
  State<GestureDemoScreen> createState() => _GestureDemoScreenState();
}

class _GestureDemoScreenState extends State<GestureDemoScreen> {
  String text = 'Interact with the box';

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(title: const Text('Gesture Detector Basics')),
      body: Center(
        child: GestureDetector(
          onDoubleTap: () {
            setState(() {
              text = 'Double Tapped!';
            });
          },
          onHorizontalDragEnd: (details) {
            setState(() {
              if (details.primaryVelocity! > 0) {
                text = 'Swiped Right! ';
              } else if (details.primaryVelocity! < 0) {
                text = 'Swiped Left! ';
              }
            });
          },
          child: Container(
            width: 250,
            height: 250,
            color: Colors.blueBlue,
            alignment: Alignment.center,
            child: Text(
              text,
              style: const TextStyle(color: Colors.white, fontSize: 18),
            ),
          ),
        ),
      ),
    );
  }
}



