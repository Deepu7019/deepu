                data.forEach(stock => {
                    html += `<p><strong>${stock.ticker}</strong> (${stock.name}): $${stock.price}</p>`;
                });
                document.getElementById('stock-list').innerHTML = html;
            });

        // 2. Register Service Worker for offline support
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js');
