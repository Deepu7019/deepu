                document.getElementById("error").innerText = "Invalid Username or Password!";
            }
        }

        // 2. REGISTER SERVICE WORKER (Makes it installable)
        if ('serviceWorker' in navigator) {
            navigator.serviceWorker.register('sw.js');
        }
