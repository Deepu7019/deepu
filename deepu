// 2. The Counter Page (Stateful because the counter changes)
class CounterPage extends StatefulWidget {
  const CounterPage({super.key});

  @override
  State<CounterPage> createState() => _CounterPageState();
}

// 3. The State class where the data and UI live
class _CounterPageState extends State<CounterPage> {
  // This is your STATE (the data)
  int _counter = 0;

  // This function updates the state
  void _incrementCounter() {
    setState(() {
      _counter++; // This tells Flutter to redraw the screen with the new number
    });
  }

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text('Simple Click Counter'),
      ),
      // Basic UI Layout using Center and Column
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            const Text(
              'You have clicked the button this many times:',
            ),
            Text(
              '$_counter', // Displays the state variable
              style: const TextStyle(fontSize: 48, fontWeight: FontWeight.bold),
            ),
          ],
        ),
      ),
      // The Floating Action Button (UI component to trigger the action)
      floatingActionButton: FloatingActionButton(
        onPressed: _incrementCounter, // Calls the state management function
        child: const Icon(Icons.add),
      ),
    );
  }
}



