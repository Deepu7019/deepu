import 'package:flutter/material.dart';

void main() {
  runApp(MaterialApp(home: CounterHistoryPage()));
}

class CounterHistoryPage extends StatefulWidget {
  @override
  State<CounterHistoryPage> createState() => _CounterHistoryPageState();
}

class _CounterHistoryPageState extends State<CounterHistoryPage> {
  int counter = 0;
  List<int> history = [0];

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      body: Column(
        children: [
          Text('Value: $counter'),
          ElevatedButton(
            onPressed: () => setState(() { counter++; history.add(counter); }),
            child: Text('Add'),
          ),
          ElevatedButton(
            onPressed: () => setState(() { counter--; history.add(counter); }),
            child: Text('Sub'),
          ),
          ElevatedButton(
            onPressed: () => setState(() { counter = 0; history.add(counter); }),
            child: Text('Reset'),
          ),
          Expanded(
            child: ListView.builder(
              itemCount: history.length,
              itemBuilder: (context, index) {
                return Text('Value: ${history[index]}');
              },
            ),
          ),
        ],
      ),
    );
  }
}
